NODE_ENV=production
PORT=3003
TRUST_PROXY=1

DB_NAME=bookstore
DB_USER=bookstore
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_DIALECT=mysql

PAGINATION_LIMIT=5
JWT_SECRET=change-me-long-random
TAX=0
ADMIN_PASSWORD=change-me

FRONTEND_ORIGIN=https://tsx.book-store.website
DEPLOY_TARGET=google

STRIPE_SECRET_KEY_TEST_MODE_OVH=
STRIPE_SECRET_KEY_TEST_MODE_GOOGLE=
STRIPE_WEBHOOK_SECRET_TEST_MODE_OVH=
STRIPE_WEBHOOK_SECRET_TEST_MODE_GOOGLE=

SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=store@book-store.com.pl
SMTP_PASSWORD=
DOMAIN=book-store.com.pl
TO_3=tsx@book-store.com.pl

GCS_PROJECT_ID=
GCS_BUCKET_NAME=
# Prefer VM service account (ADC). On GCE leave unset — do NOT use "#" as a value.
# Optional JSON (OVH / local):
# GOOGLE_APPLICATION_CREDENTIALS=/var/www/tsx-book-store/shared/gcs-sa.json
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/YOUR_BUCKET

# Required on Google Cloud — Pub/Sub topic name or full path
ORDER_CONFIRMATION_TOPIC=tsx-order-confirmation
