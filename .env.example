NODE_ENV=development
PORT=3003
# Behind Caddy (OVH / GCE). Leave empty locally unless testing X-Forwarded-* headers.
# TRUST_PROXY=1

DB_NAME=bookstore
DB_USER=test
DB_PASSWORD=test
DB_HOST=localhost
DB_DIALECT=mysql

PAGINATION_LIMIT=5
# Generate with: openssl rand -hex 32
# Do not commit the real value. Replace this placeholder — the app will refuse to start
# if JWT_SECRET is missing, shorter than 32 characters, or this example string.
JWT_SECRET=change-me
TAX=0
ADMIN_PASSWORD=change-me

# ovh | google
DEPLOY_TARGET=ovh

STRIPE_SECRET_KEY_TEST_MODE_OVH=
STRIPE_SECRET_KEY_TEST_MODE_GOOGLE=
# Local stripe CLI webhook secret (dev only)
STRIPE_WEBHOOK_SECRET_TEST_MODE_CLI=
STRIPE_WEBHOOK_SECRET_TEST_MODE_OVH=
STRIPE_WEBHOOK_SECRET_TEST_MODE_GOOGLE=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
DOMAIN=book-store.com.pl
TO_1=
TO_2=
TO_3=tsx@book-store.com.pl

FRONTEND_ORIGIN=http://localhost:5173

# Google Cloud Storage (OVH + Google Cloud)
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: public object base URL (otherwise V4 signed URLs)
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/YOUR_BUCKET

# Google Cloud only — Pub/Sub topic for order confirmation Cloud Function
# ORDER_CONFIRMATION_TOPIC=tsx-order-confirmation
