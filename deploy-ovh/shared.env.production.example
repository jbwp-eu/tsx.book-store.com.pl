NODE_ENV=production
PORT=3003
TRUST_PROXY=1

DB_NAME=bookstore
DB_USER=bookstore
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_DIALECT=mysql

PAGINATION_LIMIT=5
# Generate with: openssl rand -hex 32 — do not leave this placeholder on the VPS.
JWT_SECRET=change-me-long-random
TAX=0
ADMIN_PASSWORD=change-me

FRONTEND_ORIGIN=https://tsx.book-store.com.pl
DEPLOY_TARGET=ovh

STRIPE_SECRET_KEY_TEST_MODE_OVH=
STRIPE_SECRET_KEY_TEST_MODE_GOOGLE=
STRIPE_WEBHOOK_SECRET_TEST_MODE_OVH=
STRIPE_WEBHOOK_SECRET_TEST_MODE_GOOGLE=

SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=store@book-store.com.pl
SMTP_PASSWORD=
DOMAIN=book-store.com.pl
TO_1=
TO_2=
TO_3=tsx@book-store.com.pl

# Google Cloud Storage (shared bucket for OVH + Google)
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
# Service account JSON on the VPS (chmod 600); not used when ADC is available
GOOGLE_APPLICATION_CREDENTIALS=/var/www/tsx-book-store/shared/gcs-sa.json
# Optional public base (omit to use V4 signed URLs)
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/YOUR_BUCKET

# Leave empty on OVH — confirmation email is sent via SMTP in the Node process
# ORDER_CONFIRMATION_TOPIC=
